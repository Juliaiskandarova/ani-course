@startuml
actor "Клиент" as Client
participant "Система бронирования камер" as Sys
participant "Хранилище броней" as Store

Client -> Sys : подать заявку(камера, начало, конец)
activate Sys
alt начало >= конец (R7)
  Sys --> Client : отказ: некорректный интервал
else начало < конец
  Sys -> Store : найти брони этой камеры в статусе ПОДТВЕРЖДЕНА,\nдля которых начало < конецБрони и конец > началоБрони
  Store --> Sys : список пересекающихся броней
  alt список не пуст (R2)
    Sys --> Client : отказ: интервал пересекается с бронью №N
    note right of Sys : бронь не создаётся
  else список пуст
    Sys -> Store : создать Бронь(камера, клиент, начало, конец,\nстатус = ПОДТВЕРЖДЕНА)
    Store --> Sys : бронь №N
    Sys --> Client : бронь №N подтверждена
  end
end
deactivate Sys
@enduml
