@startuml use_case_diagram
left to right direction
skinparam packageStyle rectangle

actor "Клиент" as Client
actor "Сотрудник проката" as Staff

rectangle "Система бронирования камер" {
    usecase "Подать заявку на бронирование" as UC1
    usecase "Просмотреть свои брони" as UC2
    usecase "Отменить подтвержденную бронь" as UC3
    usecase "Просмотреть все брони" as UC4
}

Client --> UC1
Client --> UC2
Client --> UC3
Staff --> UC4

note right of UC1
R1: Клиент подает заявку с камерой,
началом и концом интервала
end note

note right of UC2
R3: Клиент видит свои брони
end note

note right of UC3
R3: Клиент может отменить
свою подтвержденную бронь
end note

note right of UC4
R4: Сотрудник проката видит все брони
end note
@enduml
