@startuml
enum СтатусБрони {
ПОДТВЕРЖДЕНА
ОТМЕНЕНА
}
class Клиент {
• фио : String
• почта : String
}
class Камера {
• серийныйНомер : String
• модель : String
}
class Бронь {
• начало : DateTime
• конец : DateTime
• статус : СтатусБрони
}
class Заявка {
• начало : DateTime
• конец : DateTime
}
class СервисБронирования {
• податьЗаявку(клиент : Клиент, камера : Камера, начало : DateTime, конец : DateTime) : РезультатЗаявки
• отменитьБронь(клиент : Клиент, бронь : Бронь) : void
• получитьБрониКлиента(клиент : Клиент) : List<Бронь>
• получитьВсеБрони() : List<Бронь>
}
Клиент "1" -- "0.." Бронь : оформляет >
Камера "1" -- "0.." Бронь : бронируется в >
Бронь --> "1" СтатусБрони : имеет
Заявка "0.." --> "1" Клиент : подается от
Заявка "0.." --> "1" Камера : запрашивает
СервисБронирования ..> Заявка : принимает
СервисБронирования ..> Бронь : создает и обновляет
@enduml
