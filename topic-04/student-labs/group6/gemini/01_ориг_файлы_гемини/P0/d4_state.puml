@startuml
[*] --> Подтверждена : Заявка принята\n[интервал корректен и нет пересечений] (R2, R7)
state "Подтверждена\n(CONFIRMED)" as Подтверждена {
Подтверждена : entry / заблокировать интервал камеры (R2)
}
state "Отменена\n(CANCELLED)" as Отменена {
Отменена : entry / сохранить запись в истории (R8)
Отменена : entry / освободить интервал камеры (R8)
}
Подтверждена --> Отменена : Клиент отменил бронь (R3)
Отменена --> [*]
@enduml
