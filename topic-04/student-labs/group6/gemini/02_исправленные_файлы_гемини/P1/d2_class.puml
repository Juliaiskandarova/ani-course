@startuml
skinparam classAttributeIconSize 0
enum СтатусБрони {
ПОДТВЕРЖДЕНА
ОТМЕНЕНА
}
class Клиент {
+фио : String
+почта : String
}
class Камера {
+серийныйНомер : String
+модель : String
}
class Бронь {
+начало : DateTime
+конец : DateTime
+статус : СтатусБрони
}
class Заявка <<не хранится>> {
+начало : DateTime
+конец : DateTime
}
class РезультатЗаявки {
+принята : Boolean
+причинаОтказа : String
}
class СервисБронирования {
+податьЗаявку(заявка : Заявка) : РезультатЗаявки
+отменитьБронь(клиент : Клиент, бронь : Бронь) : void
+получитьБрониКлиента(клиент : Клиент) : List<Бронь>
+получитьВсеБрони() : List<Бронь>
-найтиПодтвержденныеБрони(камера : Камера) : List<Бронь>
}
Клиент "1" -- "0..*" Бронь : оформляет >
Камера "1" -- "0..*" Бронь : бронируется в >
Бронь "0..*" --> "1" СтатусБрони : имеет
Заявка "0..*" --> "1" Клиент : подается от
Заявка "0..*" --> "1" Камера : запрашивает
РезультатЗаявки "1" --> "0..1" Бронь : бронь только при принятии
СервисБронирования ..> Заявка : принимает
СервисБронирования ..> РезультатЗаявки : возвращает
СервисБронирования ..> Бронь : создает и обновляет
note bottom of СервисБронирования
Отмена: бронь принадлежит клиенту
и имеет статус ПОДТВЕРЖДЕНА (R3).
Отмена меняет статус, запись не удаляется (R8).
end note
@enduml
