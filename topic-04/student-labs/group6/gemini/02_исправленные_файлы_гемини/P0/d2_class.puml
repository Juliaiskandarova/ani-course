@startuml
skinparam classAttributeIconSize 0
enum BookingStatus {
CONFIRMED
CANCELLED
}
class Client {
+fullName : String
+email : String
}
class Camera {
+serialNumber : String
+model : String
}
class Booking {
+startTime : DateTime
+endTime : DateTime
+status : BookingStatus
+cancel() : void
}
class RentalStaff
class BookingResult {
+accepted : Boolean
+refusalReason : String
}
class BookingService {
+submitBooking(client : Client, camera : Camera, startTime : DateTime, endTime : DateTime) : BookingResult
+cancelBooking(client : Client, booking : Booking) : void
+getClientBookings(client : Client) : List<Booking>
+getAllBookings() : List<Booking>
}
class BookingRepository {
+findConfirmed(camera : Camera) : List<Booking>
+save(booking : Booking) : void
}
Client "1" -- "0..*" Booking : оформляет >
Camera "1" -- "0..*" Booking : бронируется >
Booking "0..*" --> "1" BookingStatus : имеет статус
BookingResult "1" --> "0..1" Booking : бронь только при принятии
BookingService ..> BookingRepository : использует
BookingService ..> BookingResult : возвращает
BookingService ..> Booking : создает и обновляет
RentalStaff ..> BookingService : getAllBookings
Client ..> BookingService : submitBooking, cancelBooking,\ngetClientBookings
@enduml
