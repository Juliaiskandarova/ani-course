@startuml
autonumber

actor "Клиент" as C
boundary "Интерфейс" as UI
control "СервисБронирования" as S
entity "ХранилищеБроней" as R
entity "Бронь" as B

C -> UI : подать заявку(камера, начало, конец)
activate UI
UI -> S : податьЗаявку(клиент, камера, начало, конец)
activate S

alt начало >= конец — интервал некорректен (R7)
  S --> UI : отказ("Начало должно быть раньше конца")
  UI --> C : отказ с причиной
else интервал корректен
  S -> R : подтверждённыеПоКамере(камера)
  activate R
  R --> S : список подтверждённых броней камеры
  deactivate R

  S -> S : проверить пересечения:\nесть бронь b, у которой b.начало < конец И начало < b.конец
  note right of S
    Соприкосновение границ — не пересечение (R7).
    Отменённые брони не блокируют интервал (R8).
  end note

  alt найдена пересекающаяся подтверждённая бронь (R2)
    S --> UI : отказ("Интервал пересекается с подтверждённой бронью этой камеры")
    UI --> C : отказ с причиной
  else пересечений нет
    create B
    S -> B : создать(камера, клиент, начало, конец, статус = Подтверждена)
    activate B
    B --> S : бронь
    deactivate B
    S -> R : сохранить(бронь)
    S --> UI : бронь подтверждена(данные брони)
    UI --> C : подтверждение брони
  end
end

deactivate S
deactivate UI
@enduml
