@startuml
skinparam classAttributeIconSize 0

class "Камера" as Camera {
  +серийныйНомер : String
  +модель : String
}

class "Клиент" as Client {
  +ФИО : String
  +почта : String
}

enum "СтатусБрони" as Status {
  Подтверждена
  Отменена
}

class "Бронь" as Booking {
  +начало : DateTime
  +конец : DateTime
  +статус : СтатусБрони
  +пересекается(с : DateTime, по : DateTime) : Boolean
  +блокируетИнтервал(с : DateTime, по : DateTime) : Boolean
  +отменить()
}

class "СервисБронирования" as Service {
  +податьЗаявку(клиент : Клиент, камера : Камера, начало : DateTime, конец : DateTime) : Бронь
  +брониКлиента(клиент : Клиент) : Бронь[*]
  +всеБрони() : Бронь[*]
  +отменить(бронь : Бронь, клиент : Клиент)
}

class "ХранилищеБроней" as Repo {
  +подтверждённыеПоКамере(камера : Камера) : Бронь[*]
  +поКлиенту(клиент : Клиент) : Бронь[*]
  +все() : Бронь[*]
  +сохранить(бронь : Бронь)
}

Booking "0..*" --> "1" Camera : камера
Booking "0..*" --> "1" Client : клиент
Booking --> Status : статус
Service --> Repo : использует
Repo o-- "0..*" Booking : хранит
Service ..> Booking : создаёт / отменяет

note bottom of Booking
  R7, инвариант: начало < конец.
  пересекается = this.начало < по И с < this.конец
  (соприкосновение границ — не пересечение).
  блокируетИнтервал = (статус = Подтверждена) И пересекается.
  отменить(): только из «Подтверждена»;
  запись сохраняется, статус := Отменена (R8).
end note

note bottom of Service
  податьЗаявку: при некорректном интервале или пересечении —
  отказ с причиной, бронь не создаётся (R2, R7).
  отменить: только своя бронь данного клиента (R3).
  всеБрони доступно сотруднику проката (R4).
end note
@enduml
