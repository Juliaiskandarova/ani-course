@startuml
actor Клиент as K
participant Прокат as S
database Брони as D
K -> S : заявка(камера, начало, конец)
alt начало >= конец
  S --> K : отказ (некорректный интервал)
else корректный интервал
S -> D : найти конфликт: бронь той же камеры; начало < чужойКонец и чужоеНачало < конец
D --> S : конфликт?
alt конфликт
  S --> K : отказ (камера занята)
else свободно
  S -> D : создать подтвержденную бронь
  S --> K : подтверждение
end
end
@enduml
