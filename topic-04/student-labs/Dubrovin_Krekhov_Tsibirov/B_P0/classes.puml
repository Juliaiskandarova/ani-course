@startuml
class Клиент {
  ФИО : String
  почта : String
}
class Камера {
  серийныйНомер : String
  модель : String
}
class Бронь {
  начало : DateTime
  конец : DateTime
  статус : Статус
}
enum Статус {
  ПОДТВЕРЖДЕНА
  ОТМЕНЕНА
}
Клиент "1" -- "0..1" Бронь
Камера "1" -- "0..1" Бронь
@enduml
